{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "allow-app-info",
    "allow-list-devices",
    "allow-start-stream",
    "allow-stop-stream",
    "allow-detect-axis",
    "allow-capture-range",
    "allow-calibrate",
    "allow-load-profile",
    "allow-save-profile",
    "allow-reset-profile",
    "allow-profiled-devices",
    "allow-save-attempt",
    "allow-list-attempts",
    "allow-best-total",
    "allow-best-totals",
    "allow-audio-test-tone",
    "allow-audio-set-enabled",
    "allow-audio-set-volume",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-list-presets",
    "allow-start-drill-run",
    "allow-abort-drill-run",
    "allow-set-sim-pedals"
  ]
}
